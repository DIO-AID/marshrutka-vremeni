# Скопируй этот файл в .env и впиши свои значения. Файл .env не попадает в GitHub.

# Yandex Cloud: картинки (YandexART) и озвучка (SpeechKit)
# Консоль: console.yandex.cloud → сервисный аккаунт → API-ключ
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# VK: пользовательский токен админа сообщества (права video, offline) и ID сообщества (цифры)
VK_USER_TOKEN=
VK_GROUP_ID=
